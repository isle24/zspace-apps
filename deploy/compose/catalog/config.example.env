CATALOG_IMAGE=space-catalog:local
CATALOG_BIND_IP=127.0.0.1
CATALOG_PORT=18442
SPACE_PUBLIC_ORIGIN=https://zstore.example.com
# Production requires administrator 2FA binding; local development may use 0.
SPACE_ADMIN_2FA_REQUIRED=1
# A separate secret file; its content is never interpolated into Compose.
POSTGRES_PASSWORD_FILE=./.env.postgres-password
