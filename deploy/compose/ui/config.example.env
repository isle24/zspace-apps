# Copy to .env in this directory. Keep a fixed NAS identity origin.
NAS_ORIGIN=http://192.168.3.56:5055
# Bind the NAS's explicit LAN address to allow direct LAN access.
UI_BIND_IP=127.0.0.1
UI_PORT=18436
# The origin users open in their browser; also used for same-origin NAS grants.
# For LAN access, use http://<NAS LAN IP>:18436; for a proxy, its HTTPS origin.
UI_PUBLIC_ORIGIN=http://127.0.0.1:18436
UI_IMAGE=space-ui:local
# Existing managed NAS controller; empty uses an engine=disabled fallback.
# Use the controller's reachable NAS address, not container loopback.
SPACE_STORE_ENDPOINT=
