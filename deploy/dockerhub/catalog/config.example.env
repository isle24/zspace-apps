CATALOG_IMAGE=isle204/zspace-store:2026.10.13-r3
DOCKER_PLATFORM=linux/amd64
CATALOG_BIND_IP=127.0.0.1
CATALOG_PORT=18442
SPACE_PUBLIC_ORIGIN=https://zstore.example.com
SPACE_ADMIN_2FA_REQUIRED=1
# Fresh databases enable a 5 GiB image cache; existing saved settings are kept.
SPACE_IMAGE_CACHE_DEFAULT_BYTES=5368709120
# Relative paths are resolved next to this config. Never put the password here.
POSTGRES_PASSWORD_FILE=./.env.postgres-password
