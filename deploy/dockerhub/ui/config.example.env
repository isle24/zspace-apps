UI_IMAGE=isle204/zspace-ui:latest
DOCKER_PLATFORM=linux/amd64
# Fixed official NAS API upstream; never point this back to the UI port.
NAS_ORIGIN=http://192.168.3.56:5055
# Bind the explicit NAS LAN IP for direct LAN access, or use loopback with HTTPS.
UI_BIND_IP=127.0.0.1
UI_PORT=18436
# The origin users actually open; must match the controller's NAS identity.
UI_PUBLIC_ORIGIN=http://127.0.0.1:18436
# Required for NAS application installation; empty fallback has engine=disabled.
SPACE_STORE_ENDPOINT=
# deploy.sh ui --with-docker automatically detects the host socket GID.
